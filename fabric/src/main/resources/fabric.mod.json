{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "icon": "icon.png",
  "license": "${mod_license}",
  "authors": ["${mod_authors}"],
  "contributors": ["${mod_contributors}"],
  "contact": {
    "homepage": "${mod_homepage}",
    "issues": "${mod_issues}",
    "sources": "${mod_sources}"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.bluerecipebook.fabric.BlueRecipeBookFabric"
    ],
    "modmenu": [
      "dev.bluerecipebook.fabric.ModMenuIntegration"
    ],
    "jei_mod_plugin": [
      "dev.bluerecipebook.client.view.JeiRecipeScreen"
    ]
  },
  "mixins": [
    "bluerecipebook.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "1.21.1",
    "fabric-api": "*",
    "architectury": ">=13.0.11",
    "yet_another_config_lib_v3": ">=${yacl_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
